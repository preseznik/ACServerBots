<Window x:Class="ACEditor.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · AC Editor" Width="820" Height="650"
        MinWidth="720" MinHeight="540" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
      <StackPanel>
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Appearance changes apply immediately. Tool paths are refreshed when settings are saved."
                   Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="18">
      <TabItem Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18">
            <TextBlock Text="COLOR THEME" Foreground="{DynamicResource MutedBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,10" />
            <RadioButton x:Name="SystemThemeRadio" GroupName="Theme" Tag="System"
                         Checked="Theme_Checked" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Follow Windows" FontWeight="SemiBold" />
                <TextBlock Text="Use the Windows app color setting each time AC Editor starts."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="DarkThemeRadio" GroupName="Theme" Tag="Dark"
                         Checked="Theme_Checked" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Dark" FontWeight="SemiBold" />
                <TextBlock Text="Graphite surfaces with high-contrast light text."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="LightThemeRadio" GroupName="Theme" Tag="Light"
                         Checked="Theme_Checked">
              <StackPanel>
                <TextBlock Text="Light" FontWeight="SemiBold" />
                <TextBlock Text="Neutral light surfaces with dark text and the same editor accents."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
              </StackPanel>
            </RadioButton>

            <TextBlock Text="PREVIEW" Foreground="{DynamicResource MutedBrush}"
                       FontWeight="SemiBold" Margin="0,24,0,10" />
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Track surface" FontWeight="SemiBold" />
                  <TextBlock Text="Readable secondary information and validation state"
                             Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" />
                  <TextBox Text="Editable field" Width="260" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Content="Primary action" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Bottom" Margin="18,0,0,0" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tool Paths">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Leave a field empty to use automatic discovery and environment variables."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Label Grid.Row="1" Content="Assetto Corsa" />
            <TextBox x:Name="AssettoCorsaPath" Grid.Row="1" Grid.Column="1" Margin="4" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Tag="AssettoCorsaPath" Click="BrowseFolder_Click" />

            <Label Grid.Row="2" Content="DiRT 2" />
            <TextBox x:Name="Dirt2Path" Grid.Row="2" Grid.Column="1" Margin="4" />
            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Tag="Dirt2Path" Click="BrowseFolder_Click" />

            <Label Grid.Row="3" Content="Ego PSSG Editor" />
            <TextBox x:Name="EgoPssgPath" Grid.Row="3" Grid.Column="1" Margin="4" />
            <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Tag="EgoPssgPath" Click="BrowseFolder_Click" />

            <Label Grid.Row="4" Content="Blender" />
            <TextBox x:Name="BlenderPath" Grid.Row="4" Grid.Column="1" Margin="4" />
            <Button Grid.Row="4" Grid.Column="2" Content="Browse…" Tag="BlenderPath" Click="BrowseFile_Click" />

            <Label Grid.Row="5" Content="texconv (optional)" />
            <TextBox x:Name="TexconvPath" Grid.Row="5" Grid.Column="1" Margin="4" />
            <Button Grid.Row="5" Grid.Column="2" Content="Browse…" Tag="TexconvPath" Click="BrowseFile_Click" />

            <Label Grid.Row="6" Content="ksEditor" />
            <TextBox x:Name="KsEditorPath" Grid.Row="6" Grid.Column="1" Margin="4" />
            <Button Grid.Row="6" Grid.Column="2" Content="Browse…" Tag="KsEditorPath" Click="BrowseFile_Click" />

            <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Margin="4,12,4,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="texconv is reserved for future texture import/export conversion. Current KN5 DDS previews are decoded directly by AC Editor." />

            <Button Grid.Row="8" Grid.Column="1" Content="Clear overrides" HorizontalAlignment="Left"
                    Margin="4,16,4,4" Click="ClearPaths_Click" />
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}"
                IsDefault="True" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
