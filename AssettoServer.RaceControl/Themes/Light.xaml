<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAlternateBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D4D8DE" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6875" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9299A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D93835" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C72F2C" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#F8DEDD" />
    <SolidColorBrush x:Key="PreviewBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="#17191E" />
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1669A8" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="WarningBrush" Color="#946200" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#AEB5BF" />

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1E24" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F3F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1E24" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F8F9FA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1B1E24" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D93835" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9299A3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#D4D8DE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#D4D8DE" />
</ResourceDictionary>
