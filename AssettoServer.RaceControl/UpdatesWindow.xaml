<Window x:Class="AssettoServer.RaceControl.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Race Control updates" Width="650" Height="430" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Race Control updates" FontSize="23" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,18" />
            <CheckBox x:Name="StartupCheck" Content="Check for updates at startup" Margin="0,0,0,10"
                      Checked="Preferences_Changed" Unchecked="Preferences_Changed" />
            <CheckBox x:Name="PreviewCheck" Content="Include preview releases" Margin="0,0,0,18"
                      Checked="Preferences_Changed" Unchecked="Preferences_Changed" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="StatusText" Text="Check GitHub releases for a newer version." TextWrapping="Wrap" Margin="0,0,0,10" />
            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,18,0,12">
            <TextBlock Text="Updates download from ACServerBots on GitHub. The installer is verified before it starts. Stop your server before installing; settings and presets are kept."
                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="PortableNotice" Visibility="Collapsed" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="This installer updates the installed edition. For a portable update, open GitHub releases and extract the new portable ZIP into a new folder." />
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="GitHub releases" Click="Releases_Click" Margin="0,0,8,8" />
            <Button x:Name="CheckButton" Content="Check now" Click="Check_Click" Margin="0,0,8,8" />
            <Button x:Name="InstallButton" Content="Download and install…" Click="Install_Click" IsEnabled="False"
                    Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,0,8" />
        </WrapPanel>
    </Grid>
</Window>
