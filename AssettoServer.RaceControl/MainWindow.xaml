<Window x:Class="AssettoServer.RaceControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AssettoServer.RaceControl.Controls"
        mc:Ignorable="d"
        Title="AssettoServer Race Control"
        Width="1480" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp" Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized"
        ToolTipService.InitialShowDelay="350" ToolTipService.BetweenShowDelay="100"
        ToolTipService.ShowDuration="12000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" VerticalAlignment="Stretch" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New event" InputGestureText="Ctrl+N" Click="NewRace_Click" />
                <MenuItem Header="_Save preset" InputGestureText="Ctrl+S" Command="{Binding SavePresetCommand}" />
                <Separator />
                <MenuItem Header="_Import latest Content Manager preset" Command="{Binding ImportCmPresetCommand}" />
                <MenuItem Header="_Export new Content Manager preset" Command="{Binding ExportCmPresetCommand}" />
                <Separator />
                <MenuItem Header="Export current _server package…" Command="{Binding ExportServerPackageCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Theme">
                    <MenuItem x:Name="ThemeSystemMenuItem" Header="_System" IsCheckable="True" Click="ThemeMenu_Click" Tag="System" />
                    <MenuItem x:Name="ThemeLightMenuItem" Header="_Light" IsCheckable="True" Click="ThemeMenu_Click" Tag="Light" />
                    <MenuItem x:Name="ThemeDarkMenuItem" Header="_Dark" IsCheckable="True" Click="ThemeMenu_Click" Tag="Dark" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Open _Web GUI" Click="OpenWebGui_Click" />
                <MenuItem Header="_Settings…" Click="Settings_Click" InputGestureText="Ctrl+," />
            </MenuItem>
            <MenuItem Header="_Server">
                <MenuItem Header="_Validate" Command="{Binding ValidateCommand}" />
                <MenuItem Header="S_tage only" Command="{Binding StageCommand}" />
                <MenuItem Header="_Start new instance" Command="{Binding LaunchCommand}" />
                <Separator />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
                <MenuItem Header="_Restart" Command="{Binding RestartCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open _documentation" Click="Documentation_Click" />
                <MenuItem Header="_About Race Control" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,13,0">
                    <TextBlock Text="RC" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ASSETTOSERVER RACE CONTROL" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EventTitle}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,20,0">
                    <ComboBox Width="225" ItemsSource="{Binding SavedPresets}" SelectedItem="{Binding SelectedSavedPreset}"
                              DisplayMemberPath="Name" ToolTip="Saved Race Control presets" />
                    <Button Content="Load" Command="{Binding LoadPresetCommand}" Margin="6,0,0,0"
                            ToolTip="Load the selected saved preset into the editor." />
                    <Button Content="Save" Command="{Binding SavePresetCommand}" Margin="6,0,0,0"
                            ToolTip="Save the current event, grid, rules, bots, and network settings as a reusable preset." />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,0"
                            ToolTip="Request a graceful shutdown of the running server instance." />
                    <Button Content="STAGE &amp; START" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" Padding="20,8"
                            ToolTip="Validate the setup, create a fresh standalone instance, and start its server." />
                </StackPanel>
                <Button Grid.Column="4" Content="WEB GUI" Click="OpenWebGui_Click" Margin="10,0,0,0" VerticalAlignment="Center"
                        ToolTip="Open the auto-started browser dashboard." />
                <Button Grid.Column="5" Content="&#xE713;" Style="{StaticResource IconButton}" Click="Settings_Click"
                        ToolTip="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedPageIndex}" TabStripPlacement="Left"
                    Background="{DynamicResource WindowBrush}" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{DynamicResource WindowBrush}" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="194" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ChromeBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource WindowBrush}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Width" Value="194" />
                    <Setter Property="Height" Value="52" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="22,0" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="NavigationItem" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                    <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NavigationItem" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter TargetName="NavigationItem" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        <Setter TargetName="NavigationItem" Property="BorderThickness" Value="3,0,0,0" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="EVENT &amp; CONTENT">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Event" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Event mode" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding EventModes}" SelectedItem="{Binding EventMode, Mode=TwoWay}"
                                              Margin="0,0,0,12"
                                              ToolTip="Racing uses AssettoServer race bots and AC sessions. FPS runs the isolated CSP-required Deathmatch compatibility mode." />
                                    <TextBlock Text="Preset name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Preset.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                             ToolTip="Local preset name used when saving this Race Control setup." />
                                    <TextBlock Text="Server name shown on LAN" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Preset.ServerName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Name shown to players browsing Content Manager's Online → LAN list." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Content tools" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Refresh the local catalog or exchange this event with Content Manager. Installation paths are configured from the cog menu."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Refresh installed content" Command="{Binding RefreshContentCommand}"
                                                ToolTip="Rescan the selected Assetto Corsa installation for cars, skins, tracks, layouts, and weather." />
                                        <Button Content="Import latest CM preset" Command="{Binding ImportCmPresetCommand}" Margin="7,0,0,0"
                                                ToolTip="Replace the current setup with Content Manager's most recently modified server preset." />
                                        <Button Content="Export new CM preset" Command="{Binding ExportCmPresetCommand}" Margin="7,0,0,0"
                                                ToolTip="Write the current setup as a new Content Manager server preset without overwriting the source preset." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ContentSectionTitle}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding TrackSelectionLabel}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="DisplayName"
                                              IsTextSearchEnabled="True" Margin="0,0,0,10"
                                              ToolTip="Select an installed circuit layout. Its pit-box count limits the staged grid size." />
                                    <TextBlock Text="{Binding SelectedTrackDetails}" Foreground="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox Content="Show FPS arenas only" IsChecked="{Binding ShowPreparedFpsArenasOnly}"
                                                  ToolTip="Filter the arena list to layouts with a current Race Control FPS sidecar in AppData." />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Bounds padding (m)" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBox Text="{Binding Preset.Fps.ArenaBoundsPaddingMeters}"
                                                     Width="70" Margin="8,0,0,0"
                                                     ToolTip="Horizontal margin around spawn extents used during preparation. Use a smaller value for compact arenas; reprepare after changing it." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Prepare as FPS arena" Command="{Binding PrepareFpsArenaCommand}"
                                                    ToolTip="Generate bounded play space and safe spawn transforms from this layout without modifying installed track files." />
                                            <Button Content="Export FPS Client Pack" Command="{Binding ExportFpsClientPackCommand}" Margin="7,0,0,0"
                                                    ToolTip="Export the CSP compatibility-gate requirements for LAN clients. The online Lua is delivered by the server." />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Track preview" Style="{StaticResource SectionTitle}" />
                                    <Border Height="245" Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding SelectedTrack.PreviewPath}" Stretch="UniformToFill" />
                                    </Border>
                                    <Image Source="{Binding SelectedTrack.OutlinePath}" Height="120" Stretch="Uniform" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Conditions" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Weather" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Weather}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedWeather, Mode=TwoWay}" Margin="0,0,0,12"
                                              ToolTip="Weather preset sent to all clients for this event." />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,7,0">
                                            <TextBlock Text="Ambient °C" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Preset.Conditions.AmbientTemperatureCelsius}"
                                                     ToolTip="Ambient air temperature in degrees Celsius." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="Road °C" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Preset.Conditions.RoadTemperatureCelsius}"
                                                     ToolTip="Initial track-surface temperature in degrees Celsius." />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Time of day" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <ComboBox ItemsSource="{Binding TimeOfDayOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Hour"
                                              SelectedValue="{Binding Preset.Conditions.TimeOfDayHour, Mode=TwoWay}"
                                              ToolTip="Starting hour for the event in 24-hour local track time. Assetto Corsa stores this as its equivalent sun angle." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding GridTabTitle}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding GridSectionTitle}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EffectiveGridSummary}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="All replaceable" Command="{Binding MakeAllReplaceableCommand}"
                                    ToolTip="Enable bots and set every grid entry to Auto, allowing a human to claim any slot." />
                            <Button Content="Random skins" Command="{Binding RandomizeSkinsCommand}" Margin="7,0,0,0"
                                    ToolTip="Choose a random installed skin for each entry's selected car." />
                            <Button Content="{Binding FillGridLabel}" Command="{Binding FillGridCommand}" Margin="7,0,0,0"
                                    ToolTip="{Binding FillGridToolTip}" />
                            <Button Content="Add entry" Command="{Binding AddSlotCommand}" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0"
                                    ToolTip="Append a grid entry based on the selected row, or the last row if none is selected." />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Populate by characteristics" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <StackPanel Width="205" Margin="0,0,10,8">
                                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding GridPopulationCategories}"
                                                  SelectedItem="{Binding SelectedGridPopulationCategory}"
                                                  DisplayMemberPath="Label"
                                                  ToolTip="Choose how installed bot-capable cars are filtered before the racing grid is generated." />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,10,8">
                                        <TextBlock Text="Class" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding CarClassOptions}"
                                                  SelectedItem="{Binding GridPopulationClass}"
                                                  IsEnabled="{Binding IsGridPopulationClassEnabled}"
                                                  ToolTip="Exact class from each car's ui_car.json metadata, such as race, street, or trackday." />
                                    </StackPanel>
                                    <StackPanel Width="125" Margin="0,0,10,8">
                                        <TextBlock Text="{Binding GridPopulationCriterionLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding GridPopulationCriterionValue, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsGridPopulationCriterionEnabled}"
                                                 ToolTip="Maximum horsepower, exact model year, or maximum horsepower per tonne, according to the selected category. Cars missing the required metadata are excluded." />
                                    </StackPanel>
                                    <StackPanel Width="75" Margin="0,0,10,8">
                                        <TextBlock Text="Cars" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding GridPopulationCount, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Number of racing entries to generate. Valid range is 2 to 254, including room reserved by spectator slots." />
                                    </StackPanel>
                                    <Button Content="Populate" Command="{Binding PopulateGridCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                            ToolTip="Replace racing rows with Auto bot-until-human entries selected across the matching installed cars. Existing spectator rows are preserved." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Favorite grids" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding SavedGrids}" SelectedItem="{Binding SelectedSavedGrid}"
                                              DisplayMemberPath="Name" MinWidth="180"
                                              ToolTip="Choose a previously saved grid. Loading it changes grid rows only and retains the current event setup." />
                                    <Button Grid.Column="1" Content="Load" Command="{Binding LoadGridCommand}" Margin="7,0,0,0"
                                            ToolTip="Replace the current grid with this favorite, including slot modes, skins, ballast, restrictors, and spectator rows." />
                                    <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteGridCommand}" Margin="7,0,0,0"
                                            ToolTip="Permanently delete the selected favorite grid from local Race Control storage." />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SavedGridName, UpdateSourceTrigger=PropertyChanged}" MinWidth="180"
                                             ToolTip="Name for this favorite. Saving with an existing name updates that favorite." />
                                    <Button Grid.Column="1" Content="Save grid" Command="{Binding SaveGridCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="7,0,0,0"
                                            ToolTip="Save the current grid independently from the rest of the race preset for quick reuse." />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Style="{StaticResource Card}" Margin="0" Width="420" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Visual theme" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding FpsVisualThemes}"
                                          SelectedItem="{Binding Preset.Fps.Theme}"
                                          ToolTip="Blocks preserves the current procedural models. Modern loads the animated operator and carbine after the next server stage or restart." />
                                <TextBlock Text="Theme changes are staged with the server and never switch during a running match. Modern falls back to Blocks if any client asset fails."
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Grid}" SelectedItem="{Binding SelectedGridSlot}"
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="45" />
                            <DataGridTextColumn Binding="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}" Width="150">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Driver / bot name" ToolTip="Display name used for the human reservation or generated bot in this slot." />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Car" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Cars}" SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedCarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName"
                                                  IsTextSearchEnabled="True" MinWidth="210"
                                                  ToolTip="Installed car model assigned to this human-or-bot slot. Changing it reloads the available skins." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Skin" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Skins}" SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedSkinId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" MinWidth="180"
                                                  ToolTip="Installed skin used by this entry's selected car." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Slot mode" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.SlotModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                                  SelectedValue="{Binding Mode}"
                                                  ToolTip="Auto starts as a replaceable bot; Fixed is always a bot; None reserves a racing slot for a human; Spectator reserves a CSP camera-only connection and is excluded from the race." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Difficulty, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}" Width="78">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Skill" ToolTip="Optional per-car skill override from 0 to 1. Leave blank to derive this bot from the global Skill and Skill variance sliders." />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="ToolTip" Value="Set this car's skill from 0 to 1. Leave blank to use the global Skill plus this slot's stable Skill variance." />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Aggression, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}" Width="92">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Aggression" ToolTip="Optional per-car aggression override from 0 to 1. Leave blank to derive this bot from the global Aggression and Aggression variance sliders." />
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="ToolTip" Value="Set this car's aggression from 0 to 1. Leave blank to use the global Aggression plus this slot's stable Aggression variance." />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TeamName}" Width="130">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Team" ToolTip="Optional team name advertised for this grid entry." />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding BallastKg}" Width="75">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Ballast" ToolTip="Extra ballast mass in kilograms applied to this entry." />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding RestrictorPercent}" Width="80">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Restrictor" ToolTip="Engine restrictor percentage applied to this entry; 0 means unrestricted." />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SlotModeHelp}"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="↑" Command="{Binding MoveSlotUpCommand}" Width="42"
                                    ToolTip="Move the selected entry one grid position forward." />
                            <Button Content="↓" Command="{Binding MoveSlotDownCommand}" Width="42" Margin="6,0,0,0"
                                    ToolTip="Move the selected entry one grid position back." />
                            <Button Content="Remove selected" Command="{Binding RemoveSlotCommand}" Margin="6,0,0,0"
                                    ToolTip="Remove the selected entry. Race Control always retains at least two slots." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding SessionSectionTitle}">
                <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFpsMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <WrapPanel Margin="24">
                        <Border Style="{StaticResource Card}" Width="390">
                            <StackPanel>
                                <TextBlock Text="Sessions" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Practice" IsChecked="{Binding Preset.Sessions.PracticeEnabled}"
                                          ToolTip="Include an open practice session before qualifying or the race." />
                                <TextBlock Text="Practice minutes" Style="{StaticResource FieldLabel}" Margin="0,7,0,5" />
                                <TextBox Text="{Binding Preset.Sessions.PracticeMinutes}"
                                         ToolTip="Duration of practice in minutes when practice is enabled." />
                                <CheckBox Content="Qualifying" IsChecked="{Binding Preset.Sessions.QualifyingEnabled}" Margin="0,14,0,5"
                                          ToolTip="Include a timed qualifying session before the race." />
                                <TextBlock Text="Qualifying minutes" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Sessions.QualifyingMinutes}"
                                         ToolTip="Duration of qualifying in minutes when qualifying is enabled." />
                                <TextBlock Text="Race laps" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                <TextBox Text="{Binding Preset.Sessions.RaceLaps}"
                                         ToolTip="Number of laps required to finish the race." />
                                <CheckBox Content="Reverse grid" IsChecked="{Binding Preset.Sessions.ReverseGrid}" Margin="0,10,0,0"
                                          ToolTip="Reverse the qualifying order when assigning race grid positions." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="390">
                            <StackPanel>
                                <TextBlock Text="Simulation rates" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Fuel consumption %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Rules.FuelRatePercent}" Margin="0,0,0,12"
                                         ToolTip="Fuel-use multiplier: 100% is normal consumption and 0% disables fuel use." />
                                <TextBlock Text="Damage %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Rules.DamageRatePercent}" Margin="0,0,0,12"
                                         ToolTip="Damage multiplier: 100% is normal damage and 0% disables damage." />
                                <TextBlock Text="Tyre wear %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Rules.TyreWearRatePercent}" Margin="0,0,0,12"
                                         ToolTip="Tyre-wear multiplier: 100% is normal wear and 0% disables wear." />
                                <TextBlock Text="Allowed tyres out" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Rules.AllowedTyresOut}"
                                         ToolTip="Number of tyres allowed outside the legal track boundary before a cut penalty can apply." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="390">
                            <StackPanel>
                                <TextBlock Text="Assists" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="ABS: 0 off, 1 factory, 2 on" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Rules.AbsAllowed}" Margin="0,0,0,12"
                                         ToolTip="ABS policy: 0 disables it, 1 follows the car's factory capability, and 2 forces it available." />
                                <TextBlock Text="TC: 0 off, 1 factory, 2 on" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Rules.TractionControlAllowed}" Margin="0,0,0,12"
                                         ToolTip="Traction-control policy: 0 disables it, 1 follows factory capability, and 2 forces it available." />
                                <CheckBox Content="Stability control" IsChecked="{Binding Preset.Rules.StabilityControlAllowed}"
                                          ToolTip="Allow clients to use Assetto Corsa's stability-control driving aid." />
                                <CheckBox Content="Auto clutch" IsChecked="{Binding Preset.Rules.AutoClutchAllowed}"
                                          ToolTip="Allow clients to use automatic clutch assistance." />
                                <CheckBox Content="Tyre blankets" IsChecked="{Binding Preset.Rules.TyreBlanketsAllowed}"
                                          ToolTip="Start cars with pre-heated tyres rather than cold tyres." />
                                <CheckBox Content="Force virtual mirror" IsChecked="{Binding Preset.Rules.VirtualMirrorAllowed}"
                                          ToolTip="Require the virtual rear-view mirror for every connected client." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="390">
                            <StackPanel>
                                <TextBlock Text="Track evolution" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Starting grip %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Conditions.StartingGripPercent}" Margin="0,0,0,12"
                                         ToolTip="Track grip available at the beginning of the first session." />
                                <TextBlock Text="Randomness %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Conditions.GripRandomnessPercent}" Margin="0,0,0,12"
                                         ToolTip="Random variation applied to the configured starting grip." />
                                <TextBlock Text="Session transfer %" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Conditions.GripTransferPercent}" Margin="0,0,0,12"
                                         ToolTip="Percentage of the previous session's gained grip carried into the next session." />
                                <TextBlock Text="Laps per grip increase" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Conditions.LapsPerGripIncrease}"
                                         ToolTip="Completed laps required for each incremental increase in track grip." />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFpsMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <WrapPanel Margin="24">
                        <Border Style="{StaticResource Card}" Width="420">
                            <StackPanel>
                                <TextBlock Text="Deathmatch" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Match type" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="Deathmatch" IsReadOnly="True"
                                         ToolTip="V1 supports free-for-all Deathmatch only." />
                                <TextBlock Text="Time limit (minutes)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox Text="{Binding Preset.Fps.TimeLimitMinutes}"
                                         ToolTip="The authoritative match ends when this many minutes elapse. Set a positive value from 1 to 180." />
                                <TextBlock Text="Kill target" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox Text="{Binding Preset.Fps.KillLimit}"
                                         ToolTip="The authoritative match ends as soon as a participant reaches this many kills." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="420">
                            <StackPanel>
                                <TextBlock Text="Respawning" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Respawn delay (seconds)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Fps.RespawnSeconds}" Margin="0,0,0,12"
                                         ToolTip="Time a dead participant waits before the server chooses a safe spawn." />
                                <TextBlock Text="Spawn protection (seconds)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Fps.SpawnProtectionSeconds}"
                                         ToolTip="Brief immunity after spawning. The server still controls all damage and scoring." />
                                <TextBlock Text="The match runs inside one long AC Practice session; laps and AC race results are not used."
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="420">
                            <StackPanel>
                                <TextBlock Text="Loadouts" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Allowed main weapons" Style="{StaticResource FieldLabel}" />
                                <CheckBox Content="Assault Rifle" IsChecked="{Binding AllowAssaultRifle}" />
                                <CheckBox Content="MP5 SMG" IsChecked="{Binding AllowCompactSmg}" />
                                <TextBlock Text="Allowed lethal equipment" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <CheckBox Content="Frag Grenade" IsChecked="{Binding AllowFragGrenade}" />
                                <CheckBox Content="Sticky Grenade" IsChecked="{Binding AllowStickyGrenade}" />
                                <TextBlock Text="Allowed secondary weapons" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <CheckBox Content="Desert Eagle" IsChecked="{Binding AllowDesertEagle}" />
                                <CheckBox Content="Colt 1911" IsChecked="{Binding AllowColt1911}" />
                                <TextBlock Text="Human default" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                <ComboBox ItemsSource="{Binding FpsMainWeapons}" SelectedItem="{Binding Preset.Fps.Loadouts.HumanDefault.MainWeapon}" />
                                <ComboBox ItemsSource="{Binding FpsLethals}" SelectedItem="{Binding Preset.Fps.Loadouts.HumanDefault.Lethal}" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding FpsSecondaryWeapons}" SelectedItem="{Binding Preset.Fps.Loadouts.HumanDefault.SecondaryWeapon}" Margin="0,6,0,0" />
                                <TextBlock Text="Bot default" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                                <ComboBox ItemsSource="{Binding FpsMainWeapons}" SelectedItem="{Binding Preset.Fps.Loadouts.BotDefault.MainWeapon}" />
                                <ComboBox ItemsSource="{Binding FpsLethals}" SelectedItem="{Binding Preset.Fps.Loadouts.BotDefault.Lethal}" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding FpsSecondaryWeapons}" SelectedItem="{Binding Preset.Fps.Loadouts.BotDefault.SecondaryWeapon}" Margin="0,6,0,0" />
                                <TextBlock Text="Players must confirm their loadout before spawning. Pause-menu changes apply on the next respawn."
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding BotSectionTitle}">
                <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFpsMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Bot participation" Style="{StaticResource SectionTitle}" />
                                    <CheckBox Content="Enable server-authoritative race bots" IsChecked="{Binding Preset.Bots.Enabled}" FontWeight="SemiBold"
                                              ToolTip="Populate Auto and Fixed grid slots with bots simulated by the standalone server." />
                                    <TextBlock Text="When disabled, every staged grid entry becomes human-only. The saved slot modes are retained."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                                    <CheckBox Content="Humans can replace Auto bots during a race" IsChecked="{Binding Preset.Bots.AllowMidRaceTakeover}"
                                              ToolTip="Let a joining player claim an Auto slot after the race has started; Fixed bots remain protected." />
                                    <TextBlock Text="Player slot selection" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <ComboBox ItemsSource="{Binding PlayerJoinSlotSelections}"
                                              SelectedItem="{Binding Preset.Bots.JoinSlotSelection}"
                                              ToolTip="Choose among eligible slots matching the player's selected car: First uses the lowest configured CAR_n, Last uses the highest, and Random chooses independently per connection. Explicitly reserved slots retain priority." />
                                    <CheckBox Content="Restart session when the first human connects" IsChecked="{Binding Preset.Bots.RestartWhenFirstHumanConnects}"
                                              Margin="0,12,0,0"
                                              ToolTip="If only bots are present, reset the current session when the first human joins so everyone starts together." />
                                    <CheckBox x:Name="UseParodyNamesCheckBox"
                                              Content="Use random parody race-driver names"
                                              IsChecked="{Binding Preset.Bots.UseParodyNames}"
                                              Margin="0,12,0,0"
                                              ToolTip="Give every bot a unique parody racing name. Assignments are randomized on server launch and remain stable across race restarts." />
                                    <TextBlock Text="Custom bot name prefix" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"
                                               ToolTip="Prefix used for bot names when random parody names are disabled." />
                                    <TextBox Text="{Binding Preset.Bots.NamePrefix}"
                                             ToolTip="Prefix used for bot names when random parody names are disabled. Bots are named &lt;prefix&gt; &lt;slot number&gt;.">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=UseParodyNamesCheckBox, Path=IsChecked}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Racecraft" Style="{StaticResource SectionTitle}" />
                                    <Grid ToolTip="Baseline bot pace from 0 to 1. Higher skill carries more speed through corners and brakes later. A per-car Grid value overrides it.">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Skill" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=BotSkillSlider, Path=Value, StringFormat={}{0:F2}}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <Slider x:Name="BotSkillSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                                            IsSnapToTickEnabled="True" Value="{Binding Preset.Bots.Difficulty, Mode=TwoWay}"
                                            Margin="0,2,0,7"
                                            ToolTip="Baseline bot pace from 0 to 1; higher values carry more speed and brake later." />
                                    <Grid ToolTip="Varies each automatic bot's Skill above or below the baseline by up to this percentage. The value is stable per grid slot across restarts; a per-car Grid value overrides it.">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Skill variance" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=BotSkillVarianceSlider, Path=Value, StringFormat={}{0:F0}%}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <Slider x:Name="BotSkillVarianceSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding Preset.Bots.DifficultyVariancePercent, Mode=TwoWay}"
                                            Margin="0,2,0,14"
                                            ToolTip="Deterministically vary each automatic bot above or below the baseline Skill by up to this percentage. A per-car Grid value overrides it." />
                                    <Grid ToolTip="Baseline racecraft assertiveness from 0 to 1. Higher aggression plans passes earlier, accepts smaller gaps, commits longer, and yields less readily. A per-car Grid value overrides it.">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Aggression" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=BotAggressionSlider, Path=Value, StringFormat={}{0:F2}}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <Slider x:Name="BotAggressionSlider" Minimum="0" Maximum="1" TickFrequency="0.01"
                                            IsSnapToTickEnabled="True" Value="{Binding Preset.Bots.Aggression, Mode=TwoWay}"
                                            Margin="0,2,0,7"
                                            ToolTip="Baseline overtaking and following assertiveness from 0 to 1; higher values accept smaller gaps." />
                                    <Grid ToolTip="Varies each automatic bot's Aggression above or below the baseline by up to this percentage. The value is stable per grid slot across restarts; a per-car Grid value overrides it.">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Aggression variance" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=BotAggressionVarianceSlider, Path=Value, StringFormat={}{0:F0}%}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <Slider x:Name="BotAggressionVarianceSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="{Binding Preset.Bots.AggressionVariancePercent, Mode=TwoWay}"
                                            Margin="0,2,0,14"
                                            ToolTip="Deterministically vary each automatic bot above or below the baseline Aggression by up to this percentage. A per-car Grid value overrides it." />
                                    <TextBlock Text="Blank Skill and Aggression cells in the Grid use this stable mixed-field variance. Enter 0–1 in a row to override one car."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <TextBlock Text="Start spline point" Style="{StaticResource FieldLabel}"
                                               ToolTip="fast_lane.ai point treated as the start/finish line for lap progress and wrap detection." />
                                    <TextBox Text="{Binding Preset.Bots.StartSplinePointId}"
                                             ToolTip="fast_lane.ai point treated as the start/finish line for lap progress and wrap detection." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Rigid-body physics" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Fidelity" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding PhysicsFidelities}" SelectedItem="{Binding Preset.Bots.PhysicsFidelity}" Margin="0,0,0,12"
                                              ToolTip="Choose the rigid-body solver cost and collision-detection quality; track and car geometry remain exact." />
                                    <TextBlock Text="Efficient reduces solver work; Balanced is the default; High adds the strongest solver and swept collision detection. Geometry remains exact at every level."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <TextBlock Text="Simulation update Hz" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Preset.Bots.UpdateHz}" Margin="0,0,0,12"
                                             ToolTip="Server-side bot simulation steps per second. Higher values improve response but use more CPU." />
                                    <TextBlock Text="Contact friction" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Preset.Bots.SurfaceFriction}" Margin="0,0,0,12"
                                             ToolTip="Rigid-body contact friction used for chassis, road, and vehicle contacts." />
                                    <TextBlock Text="Legacy fallback grid spacing (m)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Preset.Bots.GridSpacingMeters}"
                                             ToolTip="Retained for configuration compatibility; rigid-body race mode uses the track's exact AC_START transforms." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Model support" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Each grid entry can use an arbitrary installed model. Race Control derives a bounded vehicle profile from ui_car.json and prepares the model’s real collider.kn5. Cars without packed data or a collider are reported before launch."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFpsMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <WrapPanel Margin="24">
                        <Border Style="{StaticResource Card}" Width="440">
                            <StackPanel>
                                <TextBlock Text="FPS bot skill" Style="{StaticResource SectionTitle}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Difficulty" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=FpsDifficultySlider, Path=Value, StringFormat={}{0:F2}}" Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <Slider x:Name="FpsDifficultySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        Value="{Binding Preset.Fps.Bots.Difficulty, Mode=TwoWay}" Margin="0,2,0,8"
                                        ToolTip="Controls reaction time, aim error, target tracking, and navigation quality." />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Difficulty variance" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=FpsDifficultyVarianceSlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <Slider x:Name="FpsDifficultyVarianceSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Preset.Fps.Bots.DifficultyVariancePercent, Mode=TwoWay}" Margin="0,2,0,14"
                                        ToolTip="Applies stable per-slot variation around the baseline FPS bot difficulty." />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Aggression" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=FpsAggressionSlider, Path=Value, StringFormat={}{0:F2}}" Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <Slider x:Name="FpsAggressionSlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        Value="{Binding Preset.Fps.Bots.Aggression, Mode=TwoWay}" Margin="0,2,0,8"
                                        ToolTip="Controls pursuit, strafing, exposure, and how readily bots switch targets." />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Aggression variance" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=FpsAggressionVarianceSlider, Path=Value, StringFormat={}{0:F0}%}" Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <Slider x:Name="FpsAggressionVarianceSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Preset.Fps.Bots.AggressionVariancePercent, Mode=TwoWay}"
                                        ToolTip="Applies stable per-slot variation around the baseline FPS bot aggression." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="440">
                            <StackPanel>
                                <TextBlock Text="Survivability" Style="{StaticResource SectionTitle}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Health" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=FpsHealthSlider, Path=Value, StringFormat={}{0:F0} HP}" Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <Slider x:Name="FpsHealthSlider" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding Preset.Fps.Bots.Health, Mode=TwoWay}" Margin="0,2,0,14"
                                        ToolTip="Maximum health assigned to every FPS participant in V1, from 50 to 200 HP." />
                                <TextBlock Text="The server owns movement, line-of-sight, hits, damage, deaths, respawns, kills, and final ranking. Clients send input and never report successful hits."
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="NETWORK">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Private LAN" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="LAN-only safety policy" IsChecked="{Binding Preset.Network.LanOnly}" IsEnabled="False"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="This release always disables lobby registration, Steam authentication, UPnP, and port forwarding." />
                                <TextBlock Text="Lobby registration, Steam authentication, UPnP, and automatic port forwarding are always disabled in this release."
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,14" />
                                <TextBlock Text="Bind address" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding NetworkAddresses}" SelectedItem="{Binding Preset.Network.BindAddress}"
                                          IsEditable="True" Margin="0,0,0,12"
                                          ToolTip="Local IPv4 interface on which the server accepts LAN connections. Use a private-network address clients can reach." />
                                <TextBlock Text="TCP port" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Network.TcpPort}" Margin="0,0,0,12"
                                         ToolTip="TCP port used for Assetto Corsa client handshakes and reliable server traffic." />
                                <TextBlock Text="UDP port" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Network.UdpPort}" Margin="0,0,0,12"
                                         ToolTip="UDP port used for real-time vehicle state and race updates." />
                                <TextBlock Text="HTTP / LAN discovery port" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Preset.Network.HttpPort}"
                                         ToolTip="HTTP port used by server status and Content Manager's LAN discovery flow." />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Access" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Join password" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox controls:PasswordBinding.Attach="True"
                                                 controls:PasswordBinding.Password="{Binding Preset.Network.JoinPassword, Mode=TwoWay}" Margin="0,0,0,12"
                                                 ToolTip="Optional password every player must enter to join this server. Leave empty for open LAN access." />
                                    <TextBlock Text="Admin password" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox controls:PasswordBinding.Attach="True"
                                                 controls:PasswordBinding.Password="{Binding Preset.Network.AdminPassword, Mode=TwoWay}"
                                                 ToolTip="Password used to authenticate Assetto Corsa server administration commands." />
                                    <TextBlock Text="Passwords are stored locally with the preset, like Content Manager server presets. Do not reuse an important password."
                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Joining" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="After launch, other PCs on the same network can find the event under Content Manager → Drive → Online → LAN."
                                               TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <Button Content="Open Content Manager" Command="{Binding OpenContentManagerCommand}" HorizontalAlignment="Left"
                                            ToolTip="Launch Content Manager so this PC can browse or join the server under Online → LAN." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="LAUNCH &amp; LIVE">
                <Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Preflight" Style="{StaticResource SectionTitle}" />
                                    <Button Grid.Column="1" Content="Validate now" Command="{Binding ValidateCommand}" Margin="8,-5,0,10"
                                            ToolTip="Check content, grid capacity, settings, ports, and bot physics inputs without staging or starting a server." />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ValidationMessages}" MaxHeight="190">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Symbol}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Server instance" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding ServerStateText}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="{Binding LastInstanceSummary}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Export package…" Command="{Binding ExportServerPackageCommand}"
                                                ToolTip="Create a complete portable ZIP from the current working server. Available while the server is stopped." />
                                        <Button Content="Stage only" Command="{Binding StageCommand}"
                                                Margin="7,0,0,0"
                                                ToolTip="Validate and replace the reusable working server without launching it. Compact artifacts from the previous run are archived first." />
                                        <Button Content="Start new" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0"
                                                ToolTip="Validate, replace the reusable working server, and launch it. Compact artifacts from the previous run are archived first." />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding ProgressValue, Mode=OneWay}" Height="5" Margin="0,18,0,7" />
                                <TextBlock Grid.Row="2" Text="{Binding ProgressText}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Stop" Command="{Binding StopCommand}"
                                            ToolTip="Request a graceful shutdown of the running server." />
                                    <Button Content="Restart" Command="{Binding RestartCommand}" Margin="7,0,0,0"
                                            ToolTip="Stop and relaunch the current staged instance without rebuilding its configuration." />
                                    <ComboBox ItemsSource="{Binding RecentInstances}" SelectedItem="{Binding SelectedRecentInstance}"
                                              DisplayMemberPath="DisplayName" Width="340" Margin="14,0,0,0"
                                              ToolTip="Select the current working server or compact artifacts from an earlier run." />
                                    <Button Content="Open selected folder" Command="{Binding OpenInstanceCommand}" Margin="7,0,0,0"
                                            ToolTip="Open the selected working-server or compact-history folder." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Live server log" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,-5,0,10"
                                        ToolTip="Clear the log text displayed in this window; server files and logs on disk are unchanged." />
                            </Grid>
                            <TextBox x:Name="LogTextBox" Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" TextChanged="LogTextBox_TextChanged"
                                     Style="{StaticResource ConsoleTextBox}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding LiveTabTitle}">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Server" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start live server" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}"
                                            ToolTip="Validate and stage the current setup, start the network server, and connect this live view." />
                                    <Button Content="Stop server" Command="{Binding StopCommand}" Margin="7,0,0,0"
                                            ToolTip="{Binding StopServerToolTip}" />
                                    <Button Content="Restart server" Command="{Binding RestartCommand}" Margin="7,0,0,0"
                                            ToolTip="Restart the current staged server or simulation in the same mode." />
                                </StackPanel>
                                <TextBlock Text="{Binding ServerStateText}" FontWeight="Bold" Margin="0,10,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0">
                                <TextBlock Text="{Binding LiveSessionTitle}" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding StartRaceLabel}" Command="{Binding StartRaceCommand}" Style="{StaticResource PrimaryButton}"
                                            ToolTip="{Binding StartRaceToolTip}" />
                                    <Button Content="{Binding StopRaceLabel}" Command="{Binding StopRaceCommand}" Margin="7,0,0,0"
                                            ToolTip="{Binding StopRaceToolTip}" />
                                    <Button Content="{Binding RestartRaceLabel}" Command="{Binding RestartRaceCommand}" Margin="7,0,0,0"
                                            ToolTip="{Binding RestartRaceToolTip}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LiveControlStatus}" Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding ActiveFpsVisualTheme, StringFormat=Visual theme: {0}}"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Accelerated simulation" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="74" Margin="0,0,7,0">
                                        <TextBlock Text="Seed" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SimulationSeed}" ToolTip="Deterministic seed used for bot decisions." />
                                    </StackPanel>
                                    <StackPanel Width="88" Margin="0,0,7,0">
                                        <TextBlock Text="Limit by" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding SimulationLimitModes}"
                                                  SelectedItem="{Binding SimulationLimitMode}"
                                                  ToolTip="Choose whether the simulation stops after virtual minutes or after the leading car reaches a number of laps." />
                                    </StackPanel>
                                    <StackPanel Width="74" Margin="0,0,7,0">
                                        <TextBlock Text="{Binding SimulationLimitValueLabel}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SimulationLimitValue}"
                                                 ToolTip="Simulation duration. In Laps mode, progress follows the leading active car; normal configured race completion can still end it earlier." />
                                    </StackPanel>
                                    <Button Content="SIMULATE RACE" Command="{Binding SimulateRaceCommand}" Style="{StaticResource PrimaryButton}"
                                            VerticalAlignment="Bottom"
                                            ToolTip="Stage and run a deterministic bot-only race without network listeners. Physics time stays fixed-step and is throttled to the selected target acceleration." />
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Time acceleration" Style="{StaticResource FieldLabel}" />
                                        <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding SimulationTimeScale}"
                                                ToolTip="Target virtual-time acceleration. This remains adjustable while a simulation is running; 1× is real time and higher values run faster when the CPU can keep up." />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SimulationTimeScale, StringFormat={}{0:F0}×}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,0,2"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <StackPanel Margin="0,10,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSimulationProgressVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Simulation progress" Style="{StaticResource FieldLabel}" />
                                    <ProgressBar Minimum="0" Maximum="100" Height="9"
                                                 Value="{Binding SimulationProgressValue, Mode=OneWay}"
                                                 ToolTip="Progress toward the first stopping condition: every active competitor finishing the configured laps, or the maximum virtual-time limit." />
                                    <TextBlock Text="{Binding SimulationProgressText}" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="0">
                            <Grid>
                                <controls:LiveRaceViewport Snapshot="{Binding LiveSnapshot}"
                                                           Track="{Binding LiveTrack}"
                                                           SelectedSessionId="{Binding SelectedLiveCarSessionId, Mode=TwoWay}"
                                                           FullTrack="{Binding FullTrackView, Mode=TwoWay}"
                                                           ZoomMeters="{Binding LiveZoomMeters, Mode=TwoWay}"
                                                           ToolTip="Click a participant marker to select it. Use the mouse wheel to zoom in or out; the view, slider, and selected-participant details stay synchronized.">
                                    <controls:LiveRaceViewport.Style>
                                        <Style TargetType="controls:LiveRaceViewport">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBotTakeoverActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:LiveRaceViewport.Style>
                                </controls:LiveRaceViewport>
                                <controls:LiveRace3DViewport Snapshot="{Binding LiveSnapshot}"
                                                             Track="{Binding LiveTrack}"
                                                             SelectedSessionId="{Binding SelectedLiveCarSessionId}"
                                                             ToolTip="Live 3D chase camera targeting 60 FPS during takeover. Road elevation and vehicle poses come from authoritative server telemetry; trackside grass is generated from the AI-line boundaries. Use the mouse wheel to change camera distance.">
                                    <controls:LiveRace3DViewport.Style>
                                        <Style TargetType="controls:LiveRace3DViewport">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBotTakeoverActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:LiveRace3DViewport.Style>
                                </controls:LiveRace3DViewport>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14"
                                        Padding="10,7" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LiveSessionSummary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LiveTimingSummary}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="14"
                                        Padding="12,10" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedBotControllable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="SELECTED BOT CONTROL" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding SelectedLiveCar.Name}" FontWeight="SemiBold" Margin="0,2,0,7" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding StopGoSelectedBotText}" Command="{Binding StopGoSelectedBotCommand}"
                                                    MinWidth="66" Foreground="White" FontWeight="Bold"
                                                    ToolTip="STOP freezes the selected server bot at its current position. GO returns it to autonomous race AI.">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#C62828" />
                                                        <Setter Property="BorderBrush" Value="#C62828" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBotIsStopped}" Value="True">
                                                                <Setter Property="Background" Value="#2E7D32" />
                                                                <Setter Property="BorderBrush" Value="#2E7D32" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="TELEPORT P1" Command="{Binding TeleportSelectedBotCommand}" Margin="7,0,0,0"
                                                    ToolTip="Move the selected bot just ahead of the current physical race leader without awarding skipped lap distance." />
                                        </StackPanel>
                                        <Button Content="{Binding TakeOverSelectedBotText}" Command="{Binding TakeOverSelectedBotCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,7,0,0"
                                                ToolTip="Switch between autonomous AI and manual chase-view control using arrow keys or an Xbox controller." />
                                        <TextBlock Text="{Binding BotControlStatus}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,6,0,0" MaxWidth="250" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="18"
                                        Padding="15,10" Background="#DF111820"
                                        BorderBrush="#806E7C8C" BorderThickness="1"
                                        ToolTip="Authoritative telemetry for the manually controlled bot: road speed, current gear, and engine RPM.">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBotTakeoverActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel MinWidth="118">
                                            <TextBlock Text="SPEED" Foreground="#AFC0CF" FontSize="10" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding SelectedLiveCar.SpeedKmh, StringFormat={}{0:F0}}"
                                                           Foreground="White" FontSize="38" FontWeight="Bold" />
                                                <TextBlock Text="KM/H" Foreground="#AFC0CF" FontSize="10"
                                                           Margin="5,0,0,7" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#52606D" Margin="13,0" />
                                        <StackPanel Grid.Column="2" MinWidth="58">
                                            <TextBlock Text="GEAR" Foreground="#AFC0CF" FontSize="10" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedLiveCar.GearDisplay}" Foreground="#FFBE45"
                                                       FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="#52606D" Margin="13,0" />
                                        <StackPanel Grid.Column="4" MinWidth="94">
                                            <TextBlock Text="RPM" Foreground="#AFC0CF" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedLiveCar.EngineRpm, StringFormat={}{0:N0}}"
                                                       Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Margin="24" Padding="20" Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSimulationResultsVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SimulationResultsTitle}" FontSize="22" FontWeight="Bold" />
                                            <Button Grid.Column="1" Content="Back to map" Command="{Binding DismissSimulationResultsCommand}"
                                                    ToolTip="Hide these results and return to the final live-map frame." />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding SimulationResultsOverview}"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,14" />
                                        <DataGrid Grid.Row="2" ItemsSource="{Binding SimulationResults.Results}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  SelectionMode="Single" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="POS" Binding="{Binding Position}" Width="48" />
                                                <DataGridTextColumn Header="DRIVER / CAR" Binding="{Binding Driver}" Width="2*" />
                                                <DataGridTextColumn Header="LAPS" Binding="{Binding NumLaps}" Width="55" />
                                                <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="88" />
                                                <DataGridTextColumn Header="BEST LAP" Binding="{Binding BestLapTime}" Width="88" />
                                                <DataGridTextColumn Header="AVG KM/H" Binding="{Binding AverageSpeed}" Width="80" />
                                                <DataGridTextColumn Header="TOP KM/H" Binding="{Binding TopSpeed}" Width="80" />
                                                <DataGridTextColumn Header="CRASHES*" Binding="{Binding CrashCount}" Width="72" />
                                                <DataGridTextColumn Header="FULL STOPS" Binding="{Binding FullStopCount}" Width="78" />
                                                <DataGridTextColumn Header="STOPPED" Binding="{Binding FullyStoppedTime}" Width="82" />
                                                <DataGridTextColumn Header="RESULT" Binding="{Binding Outcome}" Width="86" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="* Crash count is a contact episode, not every physics contact frame. STOP commands are retained as deliberate obstacle tests, and the overview reports how many committed stopped-car passes completed. Full stops exclude the starting grid hold." />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Expander Header="{Binding LiveViewSectionTitle}" IsExpanded="True">
                                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LiveFocusLabel}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding LiveCars}" SelectedItem="{Binding SelectedLiveCar}"
                                              DisplayMemberPath="DisplayName" IsTextSearchEnabled="True"
                                              ToolTip="Choose the participant followed by the close top-down view." />
                                    <CheckBox Content="{Binding LiveFullViewLabel}" IsChecked="{Binding FullTrackView}"
                                              Margin="0,12,0,0"
                                              ToolTip="Show the complete map and every active participant. Clear this option to follow the selected participant." />
                                    <TextBlock Text="Follow-view width" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <Slider Minimum="50" Maximum="600" TickFrequency="25" IsSnapToTickEnabled="False"
                                            Value="{Binding LiveZoomMeters}" ToolTip="World-space width, in metres, around the selected car when full-track view is disabled." />
                                    <TextBlock Text="{Binding LiveZoomMeters, StringFormat={}{0:F0} m}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="{Binding LiveSelectedEntityTitle}" IsExpanded="True" Margin="0,12,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedLiveCar.Name}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedLiveCar.Model}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,12" />
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Kind}" FontWeight="SemiBold" />
                                            <TextBlock Text="SPEED" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding SelectedLiveCar.SpeedKmh, StringFormat={}{0:F1} km/h}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="POSITION" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding SelectedLiveCar.RacePosition, StringFormat= P{0}}" FontWeight="SemiBold" />
                                            <TextBlock Text="LAP" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Lap}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Kind}" FontWeight="SemiBold" />
                                            <TextBlock Text="KILLS" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Kills}" FontWeight="SemiBold" />
                                            <TextBlock Text="SCORE" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Score}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="HEALTH" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Health}" FontWeight="SemiBold" />
                                            <TextBlock Text="DEATHS" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding SelectedLiveCar.Deaths}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="Environment" IsExpanded="True" Margin="0,12,0,0">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFpsMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Weather" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding LiveWeatherOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Type"
                                                  SelectedValue="{Binding LiveWeatherType, Mode=TwoWay}" />
                                        <TextBlock Text="Time of day" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                        <ComboBox ItemsSource="{Binding TimeOfDayOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Hour"
                                                  SelectedValue="{Binding LiveTimeOfDayHour, Mode=TwoWay}" />
                                        <Button Content="APPLY TO MATCH" Command="{Binding ApplyLiveEnvironmentCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                                ToolTip="Broadcast the selected Pure-compatible WeatherFX type and local track time to every connected client." />
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Legend" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding LiveBotLegend}" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="9" Height="9" Fill="{DynamicResource InfoBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding LiveHumanLegend}" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding LiveSelectedLegend}" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="LAN ONLY  •  NO LOBBY  •  NO GAME FILE CHANGES" Foreground="{DynamicResource DisabledTextBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
