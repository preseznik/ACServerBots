<Window x:Class="AssettoServer.RaceControl.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Race Control settings" Width="570" Height="570" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}" SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Application-wide preferences" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{DynamicResource SectionTitle}" />
                        <TextBlock Text="Theme" Style="{DynamicResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding Settings.Theme}" />
                        <CheckBox Content="Use compact grid rows" IsChecked="{Binding Settings.CompactGridRows}" Margin="0,13,0,0" />
                        <TextBlock Text="Theme and density changes apply as soon as you save. System follows the Windows app theme on startup."
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="Startup and safety" Style="{DynamicResource SectionTitle}" />
                        <CheckBox Content="Load the most recently saved race on startup"
                                  IsChecked="{Binding Settings.LoadMostRecentPresetOnStartup}" />
                        <CheckBox Content="Return to the last open page"
                                  IsChecked="{Binding Settings.RememberLastPage}" />
                        <CheckBox Content="Confirm before stopping a running server when exiting"
                                  IsChecked="{Binding Settings.ConfirmBeforeStoppingServerOnExit}" />
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local application data" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DataRoot}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,10,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open folder" Click="OpenDataFolder_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="90" />
                <Button Content="Save settings" Click="Save_Click" Style="{DynamicResource PrimaryButton}" MinWidth="115" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
